{
  "info": {
    "name": "Atlas Backend - Semana 15 (CRUD, autorizacion e IA real)",
    "description": "Pruebas del backend de Atlas. Recorrido completo del CRUD de ideas mas los casos negativos que demuestran la autorizacion por objeto. Ningun id esta escrito a mano: el login guarda el token y cada peticion encadena el id de la respuesta anterior en variables de coleccion, asi que se ejecuta de arriba abajo cuantas veces haga falta con 'newman run Atlas.postman_collection.json'. Orden del video: Salud -> Login -> Auth me/me-db -> Crear -> Detalle -> Editar -> Ideas ingenuo/optimizado -> Dashboard MISS/HIT -> Publicar asincrono/sincrono -> Job -> Publicaciones de la idea -> Red no admitida -> Metrica -> Dashboard MISS -> Eliminar -> 404 -> Casos negativos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "idea_id", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "job_sync_id", "value": "" },
    { "key": "publicacion_id", "value": "" },
    { "key": "idea_cebo_id", "value": "" },
    { "key": "job_cebo_id", "value": "" },
    { "key": "publicacion_cebo_id", "value": "" },
    { "key": "qc_ingenuo", "value": "" },
    { "key": "email_intruso", "value": "" },
    { "key": "token_intruso", "value": "" }
  ],
  "item": [
    {
      "name": "00. Salud",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y el servicio responde ok', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "01. Auth - Registrar (opcional)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 al crear, o 409 si ese email quedo registrado en una corrida anterior', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"nuevo@atlas.app\",\n  \"nombre\": \"Usuario Nuevo\",\n  \"password\": \"atlas123\",\n  \"tono\": \"profesional\"\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "02. Auth - Login (guarda token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y devuelve un JWT', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().access_token).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@atlas.app\",\n  \"password\": \"atlas123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "03. Auth - Me (JWT, 0 consultas)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, identidad completa y X-Query-Count: 0', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.have.all.keys('id', 'email', 'nombre');",
              "    pm.expect(pm.response.headers.get('X-Query-Count')).to.eql('0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "04. Auth - Me-DB (ingenuo, 1 consulta)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y esta vez si consulto la base (X-Query-Count > 0)', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(Number(pm.response.headers.get('X-Query-Count'))).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/auth/me-db"
      }
    },
    {
      "name": "05. Ideas - Crear (guarda idea_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 y devuelve el detalle, con contenido incluido', function () {",
              "    pm.response.to.have.status(201);",
              "    var idea = pm.response.json();",
              "    pm.expect(idea.id).to.be.a('number');",
              "    pm.expect(idea.contenido).to.be.a('string');",
              "    pm.expect(idea.etiquetas).to.include('productividad');",
              "});",
              "pm.collectionVariables.set('idea_id', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Idea creada desde Postman\",\n  \"contenido\": \"Recorrido completo del CRUD: crear, leer, editar y borrar.\",\n  \"origen\": \"texto\",\n  \"etiquetas\": [\"ia\", \"productividad\"]\n}" },
        "url": "{{baseUrl}}/ideas"
      }
    },
    {
      "name": "06. Ideas - Detalle (si trae contenido)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, es la idea creada y el detalle si incluye contenido', function () {",
              "    pm.response.to.have.status(200);",
              "    var idea = pm.response.json();",
              "    pm.expect(idea.id).to.eql(Number(pm.collectionVariables.get('idea_id')));",
              "    pm.expect(idea.contenido).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ideas/{{idea_id}}"
      }
    },
    {
      "name": "07. Ideas - Editar (PATCH parcial)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, aplica solo lo enviado y reemplaza la coleccion de etiquetas', function () {",
              "    pm.response.to.have.status(200);",
              "    var idea = pm.response.json();",
              "    pm.expect(idea.titulo).to.eql('Idea editada desde Postman');",
              "    pm.expect(idea.etiquetas).to.have.members(['ia', 'crud']);",
              "    pm.expect(idea.contenido).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Idea editada desde Postman\",\n  \"etiquetas\": [\"ia\", \"crud\"]\n}" },
        "url": "{{baseUrl}}/ideas/{{idea_id}}"
      }
    },
    {
      "name": "08. Ideas - Listar INGENUO (N+1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, lista ligera (sin contenido) y X-Query-Count creciente por el N+1', function () {",
              "    pm.response.to.have.status(200);",
              "    var ideas = pm.response.json();",
              "    pm.expect(ideas).to.be.an('array').that.is.not.empty;",
              "    pm.expect(ideas[0]).to.not.have.property('contenido');",
              "    pm.expect(Number(pm.response.headers.get('X-Query-Count'))).to.be.at.least(3);",
              "});",
              "pm.collectionVariables.set('qc_ingenuo', pm.response.headers.get('X-Query-Count'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/ideas?optimized=false",
          "host": ["{{baseUrl}}"],
          "path": ["ideas"],
          "query": [{ "key": "optimized", "value": "false" }]
        }
      }
    },
    {
      "name": "09. Ideas - Listar OPTIMIZADO (eager)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, X-Query-Count constante (3) y nunca peor que el listado ingenuo', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "    var consultas = Number(pm.response.headers.get('X-Query-Count'));",
              "    pm.expect(consultas).to.be.at.most(3);",
              "    pm.expect(consultas).to.be.at.most(Number(pm.collectionVariables.get('qc_ingenuo')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/ideas?optimized=true",
          "host": ["{{baseUrl}}"],
          "path": ["ideas"],
          "query": [{ "key": "optimized", "value": "true" }]
        }
      }
    },
    {
      "name": "10. Dashboard - MISS (el PATCH invalido la clave)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y X-Cache: MISS, porque la escritura anterior borro la clave', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
              "    pm.expect(pm.response.json().total_ideas).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/dashboard/metricas"
      }
    },
    {
      "name": "11. Dashboard - HIT (servido desde Redis)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, X-Cache: HIT y 0 consultas a la base', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT');",
              "    pm.expect(pm.response.headers.get('X-Query-Count')).to.eql('0');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/dashboard/metricas"
      }
    },
    {
      "name": "12. Publicar ASINCRONO (guarda job_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202, encolado: responde al instante sin esperar a la IA', function () {",
              "    pm.response.to.have.status(202);",
              "    pm.expect(pm.response.json().modo).to.eql('asincrono');",
              "    pm.expect(pm.response.json().job_id).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('job_id', pm.response.json().job_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ideas/{{idea_id}}/publicar"
      }
    },
    {
      "name": "13. Job - Estado del encolado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y el job existe con un estado valido', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().estado).to.be.oneOf(['queued', 'processing', 'done']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/jobs/{{job_id}}"
      }
    },
    {
      "name": "14. Publicar SINCRONO (bloquea ~3s)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 en modo sincrono: el request espero a la IA', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().modo).to.eql('sincrono');",
              "});",
              "pm.collectionVariables.set('job_sync_id', pm.response.json().job_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/ideas/{{idea_id}}/publicar?sync=true",
          "host": ["{{baseUrl}}"],
          "path": ["ideas", "{{idea_id}}", "publicar"],
          "query": [{ "key": "sync", "value": "true" }]
        }
      }
    },
    {
      "name": "15. Job - Estado del sincrono (guarda publicacion_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, job terminado y con la publicacion que genero', function () {",
              "    pm.response.to.have.status(200);",
              "    var job = pm.response.json();",
              "    pm.expect(job.estado).to.eql('done');",
              "    pm.expect(job.resultado_publicacion_id).to.be.a('number');",
              "});",
              "pm.collectionVariables.set('publicacion_id', pm.response.json().resultado_publicacion_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/jobs/{{job_sync_id}}"
      }
    },
    {
      "name": "15b. Publicaciones de la idea (Semana 15)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y la lista trae el texto generado por la IA', function () {",
              "    pm.response.to.have.status(200);",
              "    const lista = pm.response.json();",
              "    pm.expect(lista).to.be.an('array').that.is.not.empty;",
              "    pm.expect(lista[0].contenido_generado).to.be.a('string').and.not.empty;",
              "    pm.expect(lista[0]).to.have.property('modelo_ia');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/ideas/{{idea_id}}/publicaciones",
          "host": ["{{baseUrl}}"],
          "path": ["ideas", "{{idea_id}}", "publicaciones"]
        }
      }
    },
    {
      "name": "15c. Publicar con red no admitida (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422: la red social se valida en el esquema PublicarIn', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"red_social\": \"tiktok\"}" },
        "url": {
          "raw": "{{baseUrl}}/ideas/{{idea_id}}/publicar",
          "host": ["{{baseUrl}}"],
          "path": ["ideas", "{{idea_id}}", "publicar"]
        }
      }
    },
    {
      "name": "16. Metrica - Registrar (invalida cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 y confirma la invalidacion explicita del cache', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().ok).to.be.true;",
              "    pm.expect(pm.response.json().cache).to.eql('invalidado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"fuente\": \"manual\",\n  \"likes\": 80,\n  \"comentarios\": 6,\n  \"compartidos\": 3,\n  \"alcance\": 1200\n}" },
        "url": "{{baseUrl}}/publicaciones/{{publicacion_id}}/metricas"
      }
    },
    {
      "name": "17. Dashboard - MISS tras invalidar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 y vuelve a ser MISS: el reporte se recalculo', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/dashboard/metricas"
      }
    },
    {
      "name": "18. Ideas - Eliminar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 y sin cuerpo, como manda el contrato del DELETE', function () {",
              "    pm.response.to.have.status(204);",
              "    pm.expect(pm.response.text()).to.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ideas/{{idea_id}}"
      }
    },
    {
      "name": "19. Ideas - Detalle de la idea borrada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404: la fila ya no existe', function () {",
              "    pm.response.to.have.status(404);",
              "    pm.expect(pm.response.json().detail).to.eql('Idea no encontrada');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ideas/{{idea_id}}"
      }
    },
    {
      "name": "20. Casos negativos",
      "description": "Lo que NO debe poder hacerse. El bloque de acceso cruzado es la evidencia de que la autorizacion por objeto quedo cerrada: sobre un recurso ajeno VIVO se responde 404 y no 403, para no revelar que existe.",
      "item": [
        {
          "name": "20.1 Sin cabecera Authorization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechazado sin credenciales: 403 de HTTPBearer (401 si se desactiva auto_error)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/ideas" }
        },
        {
          "name": "20.2 Token manipulado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401: la firma del JWT no valida', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().detail).to.include('Token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}manipulado" }],
            "url": "{{baseUrl}}/ideas"
          }
        },
        {
          "name": "20.3 Idea cebo del dueno (guarda idea_cebo_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201: el acceso cruzado necesita un recurso VIVO, la idea anterior ya se borro', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().id).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('idea_cebo_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Idea cebo para los casos negativos\",\n  \"contenido\": \"Queda viva a proposito: sobre ella se prueba el acceso cruzado.\",\n  \"origen\": \"texto\",\n  \"etiquetas\": [\"seguridad\"]\n}" },
            "url": "{{baseUrl}}/ideas"
          }
        },
        {
          "name": "20.4 PATCH sin ningun campo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 con detalle: No se envio ningun campo que actualizar', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().detail).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
